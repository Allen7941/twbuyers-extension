{
  "manifest_version": 3,
  "name": "TWBuyers 歷史價格",
  "version": "0.2.0",
  "description": "在 PChome 24h、momo 購物網與 Yahoo 購物中心自動查詢歷史價格。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://api.twbuyers.info/*",
    "https://24h.pchome.com.tw/*",
    "https://www.momoshop.com.tw/*",
    "https://tw.buy.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "TWBuyers 歷史價格",
    "default_popup": "popup.html"
  }
}
